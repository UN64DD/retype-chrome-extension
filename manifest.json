{
  "manifest_version": 3,
  "name": "Retype",
  "version": "1.0.0",
  "description": "Paste text into the popup and Retype types it into the focused text field, one character at a time.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Retype",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
