{
  "manifest_version": 3,
  "name": "Retype",
  "version": "1.0.0",
  "description": "Paste text into the Retype side panel and it types into the focused text field, one character at a time.",
  "action": {
    "default_title": "Open Retype",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "scripting", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
